NODE_ENV=production
PORT=3001
HOST=0.0.0.0
FREEAPI_DB_PATH=/app/data/llmapi.db
PROVIDER_KEYS_FILE=/run/secrets/providers.json
ENCRYPTION_KEY=replace-with-64-hex-characters
FREEAPI_DB_BACKUP_KEY=replace-with-a-different-64-hex-key
LLMAPI_BACKUP_DIR=/app/backups
ALLOWED_HOSTS=localhost,llmapi
PROXY_RATE_LIMIT_RPM=120
REQUEST_BODY_LIMIT_MB=25
REQUEST_ANALYTICS_RETENTION_DAYS=30
REQUEST_ANALYTICS_MAX_ROWS=100000
REQUEST_ANALYTICS_LOG_CLIENT=false
RESPONSE_CACHE=false
RESPONSE_CACHE_PERSIST=false
