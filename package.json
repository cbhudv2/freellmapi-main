{
  "name": "llmapi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private, headless multi-provider LLM router",
  "license": "MIT",
  "exports": {
    "./types.js": "./dist/types.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --pool=forks --fileParallelism=false",
    "test:watch": "vitest",
    "lint": "eslint .",
    "backup-now": "tsx src/scripts/backup-now.ts",
    "rotate-encryption-key": "tsx src/scripts/rotate-encryption-key.ts",
    "db:migration:up": "tsx src/db/migrate/cli.ts up",
    "db:migration:down": "tsx src/db/migrate/cli.ts down",
    "db:migration:status": "tsx src/db/migrate/cli.ts status"
  },
  "engines": {
    "node": ">=20.18.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "socks-proxy-agent": "^10.0.0",
    "undici": "^6.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^5.0.5"
  }
}
